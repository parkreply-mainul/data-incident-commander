# Planned configuration only. Exact endpoints, authentication, and supported
# versions must be verified during Phases 1-3. Never commit real credentials.

# DataHub OSS
DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN_ENV=DATAHUB_GMS_TOKEN
DATAHUB_GMS_TOKEN=

# DataHub MCP Server
DATAHUB_MCP_URL=
DATAHUB_MCP_MODE=stdio
DATAHUB_MCP_SERVER_VERSION=0.6.0
DATAHUB_MCP_TIMEOUT_SECONDS=30
DATAHUB_MCP_DOCUMENTS_ENABLED=false
DATAHUB_MCP_USER_TOOLS_ENABLED=false
DATAHUB_MCP_MUTATION_ENABLED=false

# Backend and frontend; exact development URLs are not selected in Sprint 1B
BACKEND_URL=
FRONTEND_URL=

# Future model configuration; provider and model are not selected in Sprint 1B
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Future safety limits
MAX_LINEAGE_DEPTH=3
MAX_LINEAGE_NODES=100
MAX_TOOL_CALLS=30

# Planned write-back remains disabled. Enabling it will also require verified
# capability, a permitted write path, and explicit human approval.
ENABLE_DATAHUB_WRITEBACK=false

# Public-safe example only. Copy outside Git and restrict permissions.
DIC_PROJECT_NAME=data-incident-commander
DIC_DATAHUB_VERSION=v1.6.0
DIC_MCP_SERVER_VERSION=REQUIRES_RUNTIME_VERIFICATION
DIC_REMOTE_HOST=REQUIRES_EXPLICIT_APPROVAL
DIC_REMOTE_USER=REQUIRES_EXPLICIT_APPROVAL
DIC_REMOTE_APPROVED=no
DIC_REMOTE_EXECUTION_APPROVED=no
DIC_DATAHUB_START_APPROVED=no
DIC_QUICKSTART_PROJECT_SCOPE_VERIFIED=no
DIC_CLEANUP_CONFIRMATION=no
DIC_PUBLIC_HOSTNAME=example.invalid
DIC_EXCLUSIVE_PORTS=80,443
DIC_STARTUP_TIMEOUT_SECONDS=600
DIC_HEALTH_POLL_INTERVAL_SECONDS=5
DIC_EXPECTED_SERVICES=REQUIRES_RUNTIME_VERIFICATION
DIC_VERIFIED_HEALTH_URLS=REQUIRES_RUNTIME_VERIFICATION
DIC_APPROVED_HEALTH_HOSTS=REQUIRES_RUNTIME_VERIFICATION
DIC_GMS_URL=http://datahub-gms:8080
DIC_GMS_TOKEN_ENV=DATAHUB_GMS_TOKEN
DATAHUB_GMS_TOKEN=
DIC_DATAHUB_MUTATION_ENABLED=false
DIC_DATAHUB_WRITEBACK_TAG_URN=urn:li:tag:dic-incident-recorded

# Secret values are intentionally blank. Store runtime secrets server-side.
